    },
    "Food, training, sleep and biometrics read together, so you see what moves your recovery." : {
      "comment" : "Explanation of how Trace uses the data from food, training, sleep and biometrics.",
      "isCommentAutoGenerated" : true
    },
    "Foods" : {
      "extractionState" : "manual",
      "localizations" : {
        "pl" : {
