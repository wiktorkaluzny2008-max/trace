    },
    "Added to Apple Health" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodano do Zdrowia"
          }
        }
      }
    },
    "Adds a Strength Training workout with its time and estimated calories, so it counts toward your rings and training load. If your Watch recorded this session too, the app links to that one instead and doesn't save a duplicate." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje trening siłowy z czasem i szacowanymi kaloriami, żeby liczył się do pierścieni i obciążenia treningowego. Jeśli Watch też nagrał tę sesję, aplikacja połączy się z nim i nie zapisze duplikatu."
          }
        }
      }
    },
    "Adductors" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywodziciele"
          }
        }
