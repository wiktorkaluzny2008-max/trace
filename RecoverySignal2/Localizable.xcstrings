    "=" : {

    },
    "|r| under 0.1 no link, 0.1–0.3 weak, 0.3–0.5 moderate, above 0.5 strong. 'Significant' means p < 0.05 — unlikely to be chance alone." : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "|r| poniżej 0,1 brak związku, 0,1–0,3 słaby, 0,3–0,5 umiarkowany, powyżej 0,5 silny. „Istotny” oznacza p < 0,05 — raczej nie przypadek."
          }
        }
      }
    },
    "~%lld g · %lldP %lldC %lldF" : {
      "localizations" : {
