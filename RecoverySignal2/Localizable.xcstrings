    },
    "e.g. 2 scrambled eggs, 2 slices of toast with butter and a flat white" : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "np. 2 jajka na twardo, 2 tosty z masłem i flat white"
          }
        }
      }
    },
    "e.g. 200 g chicken breast, 150 g cooked basmati rice, 1 tbsp olive oil, half an avocado" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
