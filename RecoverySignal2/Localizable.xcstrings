    },
    "Hitting 150 is the big win; 300 adds more. For muscle gain, keep most of it moderate so it doesn't eat into recovery from lifting." : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osiągnięcie 150 to duży sukces; 300 daje jeszcze więcej. Przy budowie mięśni trzymaj się głównie umiarkowanej intensywności, by nie zaburzać regeneracji po siłowni."
          }
        }
      }
    },
    "Hold 5 seconds longer than last time." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wytrzymaj 5 sekund dłużej niż ostatnio."
