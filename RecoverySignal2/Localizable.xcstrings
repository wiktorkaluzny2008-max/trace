    "0" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0"
          }
        }
      }
    },
    "0 · failure" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 · do upadku"
          }
        }
      }
    },
    "0 is a normal day for you. Negative means more worn down than usual, positive means fresher. Below −1.5 for two or more days in a row means fatigue is building up, not just one rough night." : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 to dla Ciebie zwykły dzień. Ujemna wartość oznacza większe zmęczenie niż zwykle, dodatnia — więcej świeżości. Poniżej −1,5 przez dwa dni lub dłużej oznacza narastające zmęczenie, a nie jedną gorszą noc."
          }
        }
      }
    },
    "0–9 light · 10–13 moderate · 14–17 high · 18–21 all out. The scale gets harder to climb: going from 5 to 6 takes about a fifth of the effort of going from 18 to 19." : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0–9 lekkie · 10–13 umiarkowane · 14–17 wysokie · 18–21 maksymalne. Im wyżej, tym trudniej: przejście z 5 na 6 wymaga ok. piątej części wysiłku potrzebnego z 18 na 19."
          }
        }
      }
    },
    "0–21 scale. Light under 10, moderate 10–13, high 14–17, all out 18+." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skala 0–21. Lekkie poniżej 10, umiarkowane 10–13, wysokie 14–17, maksymalne 18+."
          }
        }
      }
    },
