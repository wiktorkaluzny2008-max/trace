    "Apple Watch doesn't separate NEAT itself; this splits active energy by workout time, so an untracked walk counts as NEAT and an untracked session inflates it." : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch sam nie wydziela NEAT; tu energia aktywna jest dzielona wg czasu treningu, więc niezapisany spacer liczy się jako NEAT, a niezapisana sesja go zawyża."
          }
        }
      }
    },
