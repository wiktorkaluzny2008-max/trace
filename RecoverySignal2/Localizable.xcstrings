    "Smart-scale body fat is noisy day to day, so this only means something over several weeks and at least 0.5 kg of total change." : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tkanka tłuszczowa z wagi jest niedokładna z dnia na dzień, więc coś znaczy dopiero po kilku tygodniach i co najmniej 0,5 kg zmiany."
          }
        }
      }
