    "Walking speed" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prędkość chodu"
          }
        }
      }
    },
    "Walking speed, step length, asymmetry, double support\nand steadiness are recorded by iPhone\nRecent = last 30 days · Before = the 3 months prior\nSpeed bands: ≥1.3 m/s brisk · 1.0–1.3 healthy\n             0.8–1.0 slower · <0.8 frailty-risk range" : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prędkość chodu, długość kroku, asymetria, podwójne podparcie\ni stabilność są zapisywane przez iPhone\nOstatnio = ostatnie 30 dni · Wcześniej = 3 miesiące przedtem\nPrędkość: ≥1,3 m/s szybki · 1,0–1,3 zdrowy\n          0,8–1,0 wolniejszy · <0,8 zakres ryzyka kruchości"
          }
        }
      }
    },
    "Walking speed, weekly average" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prędkość chodu, średnia tygodniowa"
