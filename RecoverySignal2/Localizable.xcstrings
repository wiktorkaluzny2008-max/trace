    "Wake time" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pora pobudki"
          }
        }
      }
    },
    "Wake time   = your usual wake time (last 4 weeks) or one you set\nTarget      = sleep need × goal  (Peak 100% · Perform 85% · Get by 70%)\nTime in bed = target ÷ your typical sleep efficiency\nBedtime     = wake time − time in bed, ± 15 min window\nIf that's more than an hour before your usual bedtime:\n  step = usual bedtime − 45 min" : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobudka     = Twoja zwykła pora pobudki (4 tygodnie) lub ustawiona\nCel         = potrzeba snu × cel  (Szczyt 100% · Wydajność 85% · Minimum 70%)\nCzas w łóżku = cel ÷ Twoja typowa efektywność snu\nPora snu    = pobudka − czas w łóżku, okno ± 15 min\nJeśli to ponad godzinę przed zwykłą porą snu:\n  krok = zwykła pora snu − 45 min"
          }
        }
      }
    },
    "Wake up" : {
      "localizations" : {
