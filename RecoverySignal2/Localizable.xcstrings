    "Weigh in" : {
      "comment" : "Text for a quick action to weigh in.",
      "isCommentAutoGenerated" : true
    },
    "Weigh in after the bathroom and before eating or drinking, at the same time each day." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waż się po toalecie, przed jedzeniem i piciem, codziennie o tej samej porze."
          }
        }
      }
    },
    "Weigh the finished dish if you can — cooking loses water, so each 100 g ends up denser than the raw ingredients." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli możesz, zważ gotowe danie — podczas gotowania ubywa wody, więc każde 100 g jest bardziej kaloryczne niż surowe składniki."
          }
        }
      }
    },
