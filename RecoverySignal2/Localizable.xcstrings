      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: heart rate rose +%2$@ bpm today vs +%3$@ across %4$lld earlier sessions — the same work costs less, a sign of better conditioning or a fresher day."
